# Server-side only. Never commit your real .env.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_TEXT_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Set a strong password to enable /admin.
ADMIN_PASSWORD=
# Recommended for hosted apps: protects chat and paid API usage.
ACCESS_CODE=
HOST=127.0.0.1
PORT=3000
# Optional storage paths (default: ./knowledge and ./.cache)
AVATAR_KNOWLEDGE_DIR=
AVATAR_CACHE_DIR=
# Optional remote knowledge service, unrelated to hardware.
AVATAR_RAG_URL=
AVATAR_RAG_TOKEN=
AVATAR_RAG_SERVICE_TOKENS=
